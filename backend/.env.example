# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 数据库配置
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/compass_jewel

# Agent API 配置（FindCG 等 OpenAI 兼容网关）
# base_url 可填 https://www.findcg.com 或 https://www.findcg.com/v1（会自动补 /v1）
AGENT_API_KEY=your_api_key_here
AGENT_MODEL=claude-sonnet-4-6
AGENT_BASE_URL=https://www.findcg.com

# Hecksong 数据集（可选覆盖路径）
# HECKSONG_DATA_PATH=backend/data/ALL_ARTICLES.json
# HECKSONG_DATA_URL=https://raw.githubusercontent.com/Lby1102/data-in-hecksong/main/ALL_ARTICLES.json

# 应用配置
DEBUG=False
